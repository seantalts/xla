// RUN: cpu_fusion_to_mlir %s | FileCheck %s
// RUN: cpu_test_correctness %s

fusion {
  param0 = f32[4,8,3] parameter(0)
  param1 = f32[4,8,5] parameter(1)
  ROOT concat = f32[4,8,8] concatenate(param0, param1), dimensions={2}
}

// Concatenating along the most-minor dimension copies one short run per
// operand for each (outer) index pair.
// CHECK:       xla.loop ({{.*}})[%{{.*}}, %{{.*}}] -> (%[[I:.*]], %[[J:.*]]) in
// CHECK:         tensor.extract_slice %{{.*}}[%[[I]], %[[J]], 0] [1, 1, 3] [1, 1, 1]
// CHECK:         tensor.insert_slice %{{.*}} into %{{.*}}[%[[I]], %[[J]], 0] [1, 1, 3] [1, 1, 1]
// CHECK:         tensor.extract_slice %{{.*}}[%[[I]], %[[J]], 0] [1, 1, 5] [1, 1, 1]
// CHECK:         tensor.insert_slice %{{.*}} into %{{.*}}[%[[I]], %[[J]], 3] [1, 1, 5] [1, 1, 1]
// CHECK-NOT:   xla.loop
